# Copy to supabase/functions/.env for local Edge Function testing.
# Never commit actual values. Production values belong in Supabase Edge Function secrets.
# Preferred direct Gmail SMTP route; set both to enable it.
GMAIL_SMTP_USER=brushandbondgcect22@gmail.com
GMAIL_SMTP_APP_PASSWORD=store-a-fresh-app-password-in-your-secret-manager

# Optional Apps Script fallback. SMTP takes priority when configured.
GMAIL_AUTOMATION_URL=https://script.google.com/macros/s/your-deployment-id/exec
GMAIL_AUTOMATION_SECRET=use-the-random-value-stored-as-RELAY_SECRET
