# Create a private .env file and replace both values before running the admin API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Brush and Bond Administrator
PORT=3002
# Production does not insert sample gallery/event/team content unless explicitly enabled.
# Optional absolute path when the SQLite database should live outside the repository.
# DATABASE_PATH=
# Production deployments must set NODE_ENV=production, use HOST=0.0.0.0,
# and point both paths below at a persistent disk mounted by the host.
# DATABASE_PATH=/var/lib/brushandbond/brushandbond.sqlite
# UPLOADS_DIR=/var/lib/brushandbond/uploads
# Set BACKUP_DIR to a separate persistent disk or external mounted volume, then schedule `npm run backup -- "$BACKUP_DIR"`.
# BACKUP_DIR=/mnt/brushandbond-backups
# Disk alert thresholds for the filesystems holding DATABASE_PATH and UPLOADS_DIR.
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
# Mark the latest backup stale if it is older than this many hours (default 26).
BACKUP_MAX_AGE_HOURS=26

# ============================================
# EMAIL AUTOMATION CONFIGURATION
# ============================================
# SMTP Server Configuration (using official Brush and Bond Gmail)
# Gmail: smtp.gmail.com:587 (use App Password, not regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=brushandbondgcect22@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=Brush and Bond <brushandbondgcect22@gmail.com>

# Club Information (used in approval/rejection email templates)
CLUB_NAME=GCECT Art Club - Brush and Bond
CLUB_INSTAGRAM_URL=https://instagram.com/brushandbond
CLUB_EMAIL=brushandbondgcect22@gmail.com
CLUB_DESCRIPTION=We are a vibrant community of artists and creatives dedicated to celebrating art in all forms. From traditional paintings to digital art, sculptures to photography, we celebrate diverse artistic expressions.
